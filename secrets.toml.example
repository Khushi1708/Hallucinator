# ─────────────────────────────────────────────────────────────
# Paste this into: Streamlit Community Cloud > your app > Settings > Secrets
# (this file is only a template; never commit real keys to GitHub)
#
# Rules: keep everything at the top level, use straight double quotes,
# replace the placeholder with your real key, and delete lines for
# providers you are not using. Then Save and Reboot the app.
# ─────────────────────────────────────────────────────────────

# OpenAI (ChatGPT)  - key from https://platform.openai.com/api-keys  (starts with sk-)
OPENAI_API_KEY = "sk-PASTE_YOUR_OPENAI_KEY"

# Google Gemini     - key from https://aistudio.google.com/apikey     (starts with AIza)
GEMINI_API_KEY = "AIzaPASTE_YOUR_GEMINI_KEY"

# Kimi (Moonshot)   - key from your Moonshot platform account         (starts with sk-)
KIMI_API_KEY = "sk-PASTE_YOUR_KIMI_KEY"

# Kimi endpoint: it MUST match the platform where the key was created.
#   International platform (platform.moonshot.ai) -> https://api.moonshot.ai/v1
#   China platform         (platform.moonshot.cn) -> https://api.moonshot.cn/v1
KIMI_BASE_URL = "https://api.moonshot.ai/v1"
